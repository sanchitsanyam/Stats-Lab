#include <bits/stdc++.h>
using namespace std;
int main()
{
    cout<<"Enter n : ";
    double n;
    cin>>n;
    vector<double> x(n);
    vector<double> y(n);
    for(int i=0;i<n;i++){
        cin>>x[i];
    }
    for(int i=0;i<n;i++){
        cin>>y[i];
    }
    double xsum=0,ysum=0,x2sum=0,xysum=0;
    for(int i=0;i<n;i++){
        xsum +=x[i];
        ysum +=y[i];
        x2sum +=pow(x[i],2);
        xysum +=x[i]*y[i];
    }
    double a=(n*xysum-xsum*ysum)/(n*x2sum-xsum*xsum);
    double b=(1/n)*(ysum-a*xsum);
    cout<<"y="<<a<<"x +"<<b;
    

}


# Given data for Question 1
x = [5, 10, 15, 20, 25]
y = [16, 19, 23, 26, 30]

# Number of data points
n = len(x)

# Initialize sums
sum_x = 0
sum_y = 0
sum_xy = 0
sum_x2 = 0

# Loop through the data to calculate sums
for i in range(n):
    sum_x += x[i]
    sum_y += y[i]
    sum_xy += x[i] * y[i]
    sum_x2 += x[i] ** 2

# Calculating slope (b) and intercept (a)
b = (n * sum_xy - sum_x * sum_y) / (n * sum_x2 - sum_x ** 2)
a = (sum_y - b * sum_x) / n

print(f"The equation of the line is: y = {a:.2f} + {b:.2f}x")


